# Fast, disposable test harness for the appliance's BOOT-TIME logic —
# wizard-triggered daemon installs (Docker, Postgres), their bootstrap
# units, and docker compose. NOT a substitute for real hardware: this box
# almost certainly uses cloud-init + systemd-networkd rather than the
# ifupdown/interfaces(5) setup our real preseeded install produces, so
# anything network-interface-shaped (the motd IP saga) must still be
# verified on real hardware, never trusted here. Good for everything else
# in this phase: does `apt-get install docker-ce`/`postgresql` work, does
# a bootstrap unit correctly gate on a daemon, does `docker compose up`
# bring up the right containers, does systemd sequencing hold.
#
# Runs on QEMU/KVM directly (vagrant-qemu provider) — no libvirtd, no
# system daemon, no group membership changes. `vagrant up --provider qemu`.
Vagrant.configure("2") do |config|
  config.vm.box = "cloud-image/debian-13"
  config.vm.hostname = "arcnode-vagrant-test"

  # Default synced folder tries SMB, which is macOS-oriented — skip it;
  # files get onto the box via the `file` provisioner or `vagrant upload`
  # instead, same as a real appliance never has a host folder to lean on.
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.provider "qemu" do |qe|
    qe.memory = "2G"
    # Known issue with cloud/cloud-image Debian boxes on vagrant-qemu:
    # their GRUB isn't configured for a serial console, so with no VGA
    # device at all (the plugin's headless default) it hangs redrawing
    # its boot menu against a framebuffer that doesn't exist — confirmed
    # via the plugin's own wiki (ppggff/vagrant-qemu, "buster64 on
    # x86_64" page), not guessed. A real VGA device lets GRUB render
    # normally; Vagrant itself only needs SSH to come up after that.
    qe.extra_qemu_args = %w(-vga std)
  end
end
