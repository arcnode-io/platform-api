     "poll_rate_hz": 1,
     "display_name_default": "Module State of Charge",
     "publisher": "gateway",
     "binding": {
      "protocol": "synthetic",
      "operation": "weighted_mean",
      "source_measurement": "state_of_charge"
     }
    },
    "active_power": {
     "unit": "watts",
     "type": "float",
     "poll_rate_hz": 1,
     "display_name_default": "Module Active Power",
     "publisher": "gateway",
     "binding": {
      "protocol": "synthetic",
      "operation": "sum",
      "source_measurement": "active_power"
     }
    },
    "reactive_power": {
     "unit": "vars",
     "type": "float",
     "poll_rate_hz": 1,
     "display_name_default": "Module Reactive Power",
     "publisher": "gateway",
     "binding": {
      "protocol": "synthetic",
      "operation": "sum",
      "source_measurement": "reactive_power"
     }
    },
    "import_headroom": {
     "unit": "watts",
     "type": "float",
     "poll_rate_hz": 1,
     "display_name_default": "POI Import Headroom",
     "publisher": "gateway",
     "binding": {
      "protocol": "synthetic",
      "operation": "subtract",
      "inputs": [
       "sites/{site_id}/devices/operating_envelope/measurements/import_limit/watts",
       "sites/{site_id}/devices/{poi_meter_device_id}/measurements/active_power/watts"
