  "bess_module": {
   "template": "bess_module",
   "kind": "module",
   "description": "BESS module aggregation \u2014 published rollups + setpoint fanout",
   "contains": [
    {
     "template": "bess_rack",
     "qty": "scalable"
    }
   ],
   "measurements": {
