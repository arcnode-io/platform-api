    },
    "export_headroom": {
     "unit": "watts",
     "type": "float",
     "poll_rate_hz": 1,
     "display_name_default": "POI Export Headroom",
     "publisher": "gateway",
     "binding": {
      "protocol": "synthetic",
      "operation": "sum",
      "inputs": [
       "sites/{site_id}/devices/operating_envelope/measurements/export_limit/watts",
       "sites/{site_id}/devices/{poi_meter_device_id}/measurements/active_power/watts"
      ]
     }
    }
   },
   "commands": {
    "set_active_power": {
     "verb": "set",
     "target": "active_power",
     "unit": "watts",
     "payload": "float",
     "display_name_default": "Set Active Power",
     "binding": {
      "protocol": "distribute",
      "allocation_policy": "soc_weighted",
      "ramp_rate_per_sec": 0.10,
      "hysteresis_margin": 0.05,
      "hysteresis_dwell_secs": 30.0
     }
    },
    "set_reactive_power": {
     "verb": "set",
     "target": "reactive_power",
     "unit": "vars",
     "payload": "float",
     "fanout": "local_process"
    }
   },
