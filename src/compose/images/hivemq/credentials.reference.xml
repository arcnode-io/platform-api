<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  REFERENCE credentials.xml — documents the role/ACL contract and drives the
  local auth test. The real file is written at deploy by UserData with random
  passwords from Secrets Manager; only the <password> values differ.

  Topic structure is firm (system_adr §9):
    measurements  sites/{site}/devices/{device}/measurements/{measurement}/{unit}
    commands      sites/{site}/devices/{device}/commands/{verb}/{target}/{unit}
    control       system/{event_type}   (e.g. system/topology_changed)

  Seven machine/role identities:
    arcnode_gateway     pub telemetry, sub commands, sub system control plane
    arcnode_operator    pub commands down,  sub telemetry up    (HMI operator)
    arcnode_viewer      sub telemetry up                        (HMI read-only)
    arcnode_device_api  pub system/* (topology_changed)         (device-api)
    arcnode_telemetry_writer  sub telemetry → persists to DB    (telemetry-writer)
    arcnode_der_control_api   pub der_dispatch + operating_envelope measurements
                                                                (der-control-api)
    arcnode_mock_derms_dispatch_api  sub dlr_rtu_demo + test/line_loading/A
                                     (demo/smoke DERMS simulator — delivers
                                     events to der-control-api over HTTP, never
                                     publishes on the broker itself)
-->
<file-rbac>
    <users>
        <user>
            <name>arcnode_gateway</name>
            <password>gateway-test-pw</password>
            <roles><id>gateway</id></roles>
        </user>
        <user>
            <name>arcnode_telemetry_writer</name>
            <password>telemetry-writer-test-pw</password>
            <roles><id>telemetry_writer</id></roles>
        </user>
        <user>
            <name>arcnode_operator</name>
            <password>operator-test-pw</password>
            <roles><id>operator</id></roles>
        </user>
        <user>
            <name>arcnode_viewer</name>
            <password>viewer-test-pw</password>
            <roles><id>viewer</id></roles>
        </user>
        <user>
            <name>arcnode_device_api</name>
            <password>device-api-test-pw</password>
            <roles><id>device_api</id></roles>
        </user>
        <user>
            <name>arcnode_der_control_api</name>
            <password>der-control-api-test-pw</password>
            <roles><id>der_control_api</id></roles>
        </user>
        <user>
            <name>arcnode_mock_derms_dispatch_api</name>
            <password>mock-derms-dispatch-api-test-pw</password>
            <roles><id>mock_derms_dispatch_api</id></roles>
        </user>
    </users>
    <roles>
        <role>
            <id>gateway</id>
            <permissions>
                <permission>
                    <topic>sites/+/devices/+/measurements/#</topic>
                    <activity>PUBLISH</activity>
                </permission>
                <permission>
                    <topic>sites/+/devices/+/measurements/#</topic>
                    <activity>SUBSCRIBE</activity>
                </permission>
                <permission>
                    <topic>sites/+/devices/+/commands/#</topic>
                    <activity>SUBSCRIBE</activity>
                </permission>
                <permission>
                    <topic>system/#</topic>
                    <activity>SUBSCRIBE</activity>
                </permission>
                <permission>
                    <topic>sites/+/devices/+/events/#</topic>
                    <activity>PUBLISH</activity>
                </permission>
            </permissions>
        </role>
        <role>
            <id>device_api</id>
            <permissions>
                <permission>
                    <topic>system/#</topic>
                    <activity>PUBLISH</activity>
                </permission>
            </permissions>
        </role>
        <role>
            <id>telemetry_writer</id>
            <permissions>
                <permission>
                    <topic>sites/+/devices/+/measurements/#</topic>
                    <activity>SUBSCRIBE</activity>
                </permission>
            </permissions>
        </role>
        <role>
            <id>der_control_api</id>
            <permissions>
                <permission>
                    <topic>sites/+/devices/der_dispatch/measurements/#</topic>
                    <activity>PUBLISH</activity>
                </permission>
                <permission>
                    <topic>sites/+/devices/operating_envelope/measurements/#</topic>
                    <activity>PUBLISH</activity>
                </permission>
            </permissions>
        </role>
        <role>
            <id>mock_derms_dispatch_api</id>
            <permissions>
                <permission>
                    <topic>sites/+/devices/dlr_rtu_demo/measurements/#</topic>
                    <activity>SUBSCRIBE</activity>
                </permission>
                <permission>
                    <topic>test/line_loading/A</topic>
                    <activity>SUBSCRIBE</activity>
                </permission>
            </permissions>
        </role>
        <role>
            <id>operator</id>
            <permissions>
                <permission>
                    <topic>sites/+/devices/+/commands/#</topic>
                    <activity>PUBLISH</activity>
                </permission>
                <permission>
                    <topic>sites/+/devices/+/measurements/#</topic>
                    <activity>SUBSCRIBE</activity>
                </permission>
                <permission>
                    <topic>sites/+/devices/+/events/#</topic>
                    <activity>SUBSCRIBE</activity>
                </permission>
            </permissions>
        </role>
        <role>
            <id>viewer</id>
            <permissions>
                <permission>
                    <topic>sites/+/devices/+/measurements/#</topic>
                    <activity>SUBSCRIBE</activity>
                </permission>
                <permission>
                    <topic>sites/+/devices/+/events/#</topic>
                    <activity>SUBSCRIBE</activity>
                </permission>
            </permissions>
        </role>
    </roles>
</file-rbac>
