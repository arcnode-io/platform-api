# EMQX rule + Postgres connector for telemetry write — commercial + ISO.
#
# Backend = TimescaleDB (Tiger Cloud in commercial, self-hosted in ISO).
# Rendered at boot by the `emqx-rule-render` init container, which
# substitutes {host}, {port}, {user}, {password}, {db} from the parsed
# TIMESERIES_URL env var. EMQX reads the rendered file from
# /etc/emqx/etc/rule.conf.
#
# Topic shape: sites/{{site_id}}/devices/{{device_id}}/measurements/{{measurement}}/{{unit}}
# Payload: {{"ts": "<ISO8601>", "value": <number|bool|string>}} per ADR §12.
#
# The polymorphic `value` lands in a JSONB column — ADR §3-Q lock — so the
# INSERT casts via `${{value}}::jsonb` regardless of underlying scalar type.

connectors.postgresql.timeseries {{
  server   = "{host}:{port}"
  database = "{db}"
  username = "{user}"
  password = "{password}"
  pool_size = 8
}}

actions.postgresql.timeseries_writer {{
  connector = timeseries
  parameters {{
    sql = """
      INSERT INTO measurements (ts, site_id, device_id, measurement, unit, value)
      VALUES (${{ts}}::timestamptz, ${{site_id}}, ${{device_id}}, ${{measurement}}, ${{unit}}, ${{value}}::jsonb)
    """
  }}
}}

rule_engine.rules.telemetry_write {{
  sql = """
    SELECT
      payload.ts                       as ts,
      nth(2, tokens(topic, '/'))       as site_id,
      nth(4, tokens(topic, '/'))       as device_id,
      nth(6, tokens(topic, '/'))       as measurement,
      nth(7, tokens(topic, '/'))       as unit,
      payload.value                    as value
    FROM "sites/+/devices/+/measurements/+/+"
  """
  actions = ["postgresql:timeseries_writer"]
}}
