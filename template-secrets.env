POSTGRES_PASSWORD=
# Namecheap API key for arcnode.io DNS records (user iotresister; caller IP must be whitelisted)
NAMECHEAP_API_KEY=
# Resend API key: the delivery email when cfg.yml email_provider is resend
RESEND_API_KEY=
# HMAC key for the per-order site callback tokens baked into each cloud template
SITE_TOKEN_SECRET=
# IAM user key that signs the customer bundle link (cloud only); read-only on orders/*
PRESIGN_ACCESS_KEY_ID=
# Secret half of the presign key above
PRESIGN_SECRET_ACCESS_KEY=
